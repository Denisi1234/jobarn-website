# JOBARN - Professional hardening
# Force HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Remove index.html from URL canonical
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Fix Google-indexed clean URLs from new site version -> old .html files
# Prevents 404 when clicking search results like /services, /about-us, /products
RewriteRule ^services/?$ /services.html [R=301,L]
RewriteRule ^about-us/?$ /about.html [R=301,L]
RewriteRule ^about/?$ /about.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^products/?$ /services.html [R=301,L]
RewriteRule ^clients/?$ /projects.html [R=301,L]
RewriteRule ^blog/?$ /news.html [R=301,L]
RewriteRule ^projects/?$ /projects.html [R=301,L]
RewriteRule ^news/?$ /news.html [R=301,L]
RewriteRule ^faq/?$ /faq.html [R=301,L]

# Generic fallback: any extensionless URL with matching .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L]

# Block access to sensitive files
RewriteRule ^\.git - [F,L]
RewriteRule ^messages/ - [F,L]
<FilesMatch "^(mail\.php)$">
  <LimitExcept POST>
    Require all denied
  </LimitExcept>
</FilesMatch>
</IfModule>

# Protect verification + private files but allow Google file
<FilesMatch "^\.">
Require all denied
</FilesMatch>
<Files "google505200829a39cb45.html">
Require all granted
</Files>
<Files "robots.txt">
Require all granted
</Files>
<Files "sitemap.xml">
Require all granted
</Files>

# Security headers
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' https://www.google.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; frame-src 'self' https://www.google.com https://www.youtube.com; font-src 'self' data: https:; connect-src 'self' https:"
Header unset Server
</IfModule>

# Disable directory listing
Options -Indexes

# Compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Caching - 1 month for static, no cache for html
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
